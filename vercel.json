{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/season-ideas?run=1&at=7",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/season-ideas?run=1&at=8",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/q/:id",
      "destination": "/api/shared?ogq=:id"
    },
    {
      "source": "/r/:sid",
      "destination": "/api/shared?og=:sid"
    },
    {
      "source": "/api/publish",
      "destination": "/api/circle?via=pub"
    },
    {
      "source": "/api/sync",
      "destination": "/api/circle?via=sync"
    },
    {
      "source": "/api/auth",
      "destination": "/api/circle?via=auth"
    }
  ]
}
