{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/season-ideas?run=1&at=7",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/season-ideas?run=1&at=8",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/moderation?inactive=1&run=1",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/legal",
      "destination": "/legal.html"
    },
    {
      "source": "/q/:id",
      "destination": "/api/shared?ogq=:id"
    },
    {
      "source": "/r/:sid",
      "destination": "/api/shared?og=:sid"
    },
    {
      "source": "/l/:code",
      "destination": "/api/circle?via=lnk&c=:code"
    },
    {
      "source": "/api/publish",
      "destination": "/api/circle?via=pub"
    },
    {
      "source": "/api/sync",
      "destination": "/api/circle?via=sync"
    },
    {
      "source": "/api/auth",
      "destination": "/api/circle?via=auth"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
